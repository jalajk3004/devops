generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  PENDING
  PROCESSING
  EXTRACTED
  FAILED
}

model Invoice {
  id          String        @id @default(uuid())
  rawText     String
  status      InvoiceStatus @default(PENDING)

  vendor      String?
  amount      Float?
  currency    String?
  dueDate     DateTime?
  category    String?

  llmModel    String?
  llmLatencyMs Int?
  llmCostUsd  Float?
  attempts    Int           @default(0)
  errorReason String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}
